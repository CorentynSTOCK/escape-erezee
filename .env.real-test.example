# Copy this file to .env.real-test.local for a real Stripe/Resend test.
# Keep .env.real-test.local private and do not publish it.

PORT=4181
HOST=0.0.0.0
PUBLIC_APP_URL=https://escape-erezee.be

ADMIN_PASSWORD=your-private-admin-password
ADMIN_SESSION_SECRET=your-long-random-admin-session-secret

# Stripe test mode first.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend e-mail sending.
RESEND_API_KEY=re_xxx
MAIL_FROM=Escape Erezee <contact@escape-erezee.be>
MAIL_REPLY_TO=contact@escape-erezee.be
